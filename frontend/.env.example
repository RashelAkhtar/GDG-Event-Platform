# Keep this server-only (do not prefix with NEXT_PUBLIC_). Use a unique, hard-to-guess path.
ADMIN_PANEL_PATH=/replace-with-a-private-random-path

# API requests are proxied through the frontend origin, so auth cookies remain first-party.
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_API_ORIGIN=http://localhost:5000

# WebSockets connect directly to the backend and need an explicit URL when the API URL is relative.
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws
