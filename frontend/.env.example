# Keep this server-only (do not prefix with NEXT_PUBLIC_). Use a unique, hard-to-guess path.
ADMIN_PANEL_PATH=/replace-with-a-private-random-path

# Public API URL. The WebSocket URL defaults to this host's /ws endpoint.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional WebSocket URL override.
# NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws
